          "stringUnit": {
            "state": "translated",
            "value": "此次导入超出了当前文档 %lld 百万像素的总量限制或每边 %@ 像素的限制。"
          }
        }
      }
    },
    "This is not a valid Compositor project, or its metadata is damaged.": {
      "localizations": {
        "zh-Hans": {
