    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边使用 1 至 %@ 像素，总计不超过 %lld 百万像素，分辨率为 1–9,600 像素/英寸。"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间隔设为 %lld–%@ 像素，子网格数为 %lld–%lld，且不超过网格线之间的像素数。"
          }
        }
      }
    },
    "Vector shape was rasterized to pixels.": {
      "localizations": {
        "zh-Hans": {
