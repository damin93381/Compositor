    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹，本身没有像素。请在其中的图层或文件夹蒙版上绘画。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可绘制的像素。请在其蒙版上绘画。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏或位于隐藏的文件夹中。请先显示它再绘画。"
          }
        }
      }
    },
    "“%@” was changed on disk.": {
